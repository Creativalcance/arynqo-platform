{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "internal-test": {
      "extends": "preview",
      "env": { "APP_VARIANT": "internal-test" },
      "android": { "withoutCredentials": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk", "image": "latest" }
    },
    "simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "environment": "production"
    }
  }
}
